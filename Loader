local function processCommand(rawMsg)
	if type(rawMsg) ~= "string" then return end
	local lower = string.lower(rawMsg)
	local clean = normalizeText(rawMsg)

	if lower == "stark hud online." or lower == "flying" or lower == "unflying." or lower == "self destructing..." or lower == "suit deployed." or lower == "suit retracted." or lower == "suit not deployed yet, sir." or lower == "infinity gauntlet deployed." or lower == "infinity gauntlet removed." or lower == "firing blast..." or lower == "aura enabled." or lower == "aura disabled." or string.find(lower, "teleported to") or string.find(lower, "i didn't catch that") then
		return
	end
	if string.find(lower, "^%[jarvis%]:") then
		return
	end
	for _, resp in ipairs(wakeResponses) do
		if clean == normalizeText(resp) then return end
	end
	for _, entry in ipairs(qaDatabase) do
		for _, ans in ipairs(entry.answers) do
			if clean == normalizeText(ans) then return end
		end
	end

	if clean == "hey jarvis" or clean == "jarvis" then
		isListening = true
		StatusLabel.Text = "STATUS: LISTENING..."
		
		local chosenResponse = wakeResponses[math.random(1, #wakeResponses)]
		logToHUD("[Jarvis]: " .. chosenResponse, false)
		sendPublicChat(chosenResponse)
		
		task.delay(6, function()
			if isListening then
				isListening = false
				StatusLabel.Text = "STATUS: STANDBY"
				logToHUD("[Jarvis]: Timed out.", true)
			end
		end)
		return
	end

	local cleanedCommand = string.match(lower, "^hey%s+jarvis%s+(.+)$") or string.match(lower, "^jarvis%s+(.+)$")
	if cleanedCommand then
		isListening = false
		if not executeParsedCommand(cleanedCommand) then
			StatusLabel.Text = "STATUS: UNKNOWN"
			logToHUD("[Jarvis]: I Didn't catch that!", true)
			sendPublicChat("I Didn't catch that!")
		end
		return
	end

	if isListening then
		isListening = false
		if not executeParsedCommand(rawMsg) then
			StatusLabel.Text = "STATUS: UNKNOWN"
			logToHUD("[Jarvis]: I Didn't catch that!", true)
			sendPublicChat("I Didn't catch that!")
		end
	end
end

