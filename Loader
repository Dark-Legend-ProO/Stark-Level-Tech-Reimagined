-- Inertial Dragging
local dragging = false
local dragStart, startPos
local targetPos = OuterHolder.Position

local function setupDrag(frame)
	local bConn = frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = OuterHolder.Position
		end
	end)
	table.insert(_G.JarvisConnections, bConn)

	local eConn = frame.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	table.insert(_G.JarvisConnections, eConn)
end

setupDrag(MainFrame)

local cConn = UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		targetPos = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)
table.insert(_G.JarvisConnections, cConn)

local lerpConn = RunService.RenderStepped:Connect(function(dt)
	OuterHolder.Position = OuterHolder.Position:Lerp(targetPos, math.min(1, dt * 10))
end)
