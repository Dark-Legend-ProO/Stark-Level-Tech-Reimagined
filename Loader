local isListening = false
local isFlying = false
local flightSpeed = 60
local bodyVel, bodyGyro

local function stopFlight()
	isFlying = false
	if bodyVel then bodyVel:Destroy() bodyVel = nil end
	if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
	
	local char = LocalPlayer.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if humanoid then humanoid.PlatformStand = false end
end

local renderConn = RunService.RenderStepped:Connect(function()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")

	if isFlying and hrp and humanoid then
		humanoid.PlatformStand = true
		
		if not bodyVel or not bodyVel.Parent then
			bodyVel = Instance.new("BodyVelocity")
			bodyVel.MaxForce = Vector3.new(1e9, 1e9, 1e9)
			bodyVel.Parent = hrp
		end
		
		if not bodyGyro or not bodyGyro.Parent then
			bodyGyro = Instance.new("BodyGyro")
			bodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
			bodyGyro.D = 500
			bodyGyro.P = 9000
			bodyGyro.Parent = hrp
		end

		local camera = workspace.CurrentCamera
		bodyGyro.CFrame = camera.CFrame

		local moveVector = Vector3.zero
		local uis = game:GetService("UserInputService")
		if uis:IsKeyDown(Enum.KeyCode.W) then moveVector += camera.CFrame.LookVector end
		if uis:IsKeyDown(Enum.KeyCode.S) then moveVector -= camera.CFrame.LookVector end
		if uis:IsKeyDown(Enum.KeyCode.A) then moveVector -= camera.CFrame.RightVector end
		if uis:IsKeyDown(Enum.KeyCode.D) then moveVector += camera.CFrame.RightVector end

		bodyVel.Velocity = moveVector * flightSpeed
		hrp.AssemblyAngularVelocity = Vector3.zero
	else
		if bodyVel then bodyVel:Destroy() bodyVel = nil end
		if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
		if humanoid and not isFlying then humanoid.PlatformStand = false end
	end
end)
table.insert(_G.JarvisConnections, renderConn)

local function triggerSelfDestruct()
	stopFlight()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")

	if hrp and humanoid then
		StatusLabel.Text = "STATUS: OVERLOAD"
		logToHUD("[Jarvis]: Initiating overload...", true)
		sendPublicChat("Self destructing...")

		local startTime = tick()
		local spinConn
		spinConn = RunService.RenderStepped:Connect(function()
			if tick() - startTime < 0.6 then
				hrp.AssemblyAngularVelocity = Vector3.new(0, 60, 0)
			else
				spinConn:Disconnect()
				
				local explosion = Instance.new("Explosion")
				explosion.Position = hrp.Position
				explosion.BlastRadius = 10
				explosion.BlastPressure = 500000
				explosion.Parent = workspace

				humanoid.Health = 0
				StatusLabel.Text = "STATUS: STANDBY"
				logToHUD("[Jarvis]: Systems terminated.", true)
			end
		end)
		table.insert(_G.JarvisConnections, spinConn)
	end
end

