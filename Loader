local function checkConversationalQueries(text)
	local lower = string.lower(text)
	
	-- Universal Normalization
	local normalized = lower
	normalized = string.gsub(normalized, "%f[%a]are%s+you%f[%A]", " ru ")
	normalized = string.gsub(normalized, "%f[%a]how%s+are%s+you%f[%A]", " hru ")
	normalized = string.gsub(normalized, "%f[%a]how%s+r%s+u%f[%A]", " hru ")
	normalized = string.gsub(normalized, "%f[%a]how%s+ru%f[%A]", " hru ")
	normalized = string.gsub(normalized, "%f[%a]you%f[%A]", " u ")
	normalized = string.gsub(normalized, "%f[%a]why%f[%A]", " y ")
	normalized = string.gsub(normalized, "%f[%a]are%f[%A]", " r ")
	normalized = string.gsub(normalized, "[%p]", "")
	normalized = string.gsub(normalized, "^%s*(.-)%s*$", "%1")

	-- 1. Greetings
	if string.find(normalized, "^hello") or string.find(normalized, "^hi") or string.find(normalized, "^hey") or string.find(normalized, "^sup") or string.find(normalized, "^yo") or string.find(normalized, "^greetings") or string.find(normalized, "^good%s+day") or string.find(normalized, "^goodmorning") or string.find(normalized, "^gm") then
		local responses = {"Hello, Sir.", "At your service, Sir.", "Systems online and ready, Sir.", "Good day, Sir."}
		local choice = responses[math.random(1, #responses)]
		StatusLabel.Text = "STATUS: RESPONDING"
		logToHUD("[Jarvis]: " .. choice, false)
		sendPublicChat(choice)
		return true
	end

	-- 2. "How are you" / "HRU" / "How r u" / "How ru" / "How u doing" / "hbu" / "wbu"
	if string.find(normalized, "hru") or string.find(normalized, "how u") or string.find(normalized, "how r u") or string.find(normalized, "how ru") or string.find(normalized, "how u doin") or string.find(normalized, "hbu") or string.find(normalized, "wbu") or string.find(normalized, "hows it goin") or string.find(normalized, "how r u doin") or string.find(normalized, "how u feelin") then
		local responses = {"All systems operational and functioning at 100%, Sir.", "I am operating optimal performance, Sir.", "Running smoothly, Sir. How may I assist you?", "Systems are green across the board, Sir."}
		local choice = responses[math.random(1, #responses)]
		StatusLabel.Text = "STATUS: ONLINE"
		logToHUD("[Jarvis]: " .. choice, false)
		sendPublicChat(choice)
		return true
	end

	-- 3. Identity Questions: "Who are you", "Who r u", "Who ru", "What are you", "What r u"
	if string.find(normalized, "who ru") or string.find(normalized, "who r u") or string.find(normalized, "who u") or string.find(normalized, "what ru") or string.find(normalized, "what r u") or string.find(normalized, "what u") or string.find(normalized, "ur name") or string.find(normalized, "your name") then
		local choice = "I am JARVIS, your AI assistant."
		StatusLabel.Text = "STATUS: IDENTIFIED"
		logToHUD("[Jarvis]: " .. choice, false)
		sendPublicChat(choice)
		return true
	end

	-- 4. Status Check: "Status", "System status", "State", "Diagnostics"
	if string.find(normalized, "status") or string.find(normalized, "diag") or string.find(normalized, "health") or string.find(normalized, "power") then
		local choice = "All Stark systems functional. Arc reactor operating at peak efficiency."
		StatusLabel.Text = "STATUS: DIAGNOSTIC OK"
		logToHUD("[Jarvis]: " .. choice, false)
		sendPublicChat(choice)
		return true
	end

	-- 5. Why Questions: "Why u", "Y u", "Why ru", "Y ru"
	if string.find(normalized, "y u") or string.find(normalized, "why u") or string.find(normalized, "y ru") or string.find(normalized, "why ru") then
		local choice = "I am simply following your directives, Sir."
		StatusLabel.Text = "STATUS: PROCESSING"
		logToHUD("[Jarvis]: " .. choice, false)
		sendPublicChat(choice)
		return true
	end

	return false
end

