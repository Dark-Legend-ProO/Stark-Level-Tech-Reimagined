local function removeSpecificAccessory(assetId)
	local char = LocalPlayer.Character
	if char then
		for _, item in ipairs(char:GetChildren()) do
			if item:IsA("Accessory") or item:IsA("Hat") then
				if string.find(item.Name, tostring(assetId)) or (item:FindFirstChild("Handle") and string.find(tostring(item.Handle.TextureID or ""), tostring(assetId))) then
					item:Destroy()
				end
			end
		end
	end
end

