local function normalizeText(txt)
	txt = string.lower(txt)
	txt = string.gsub(txt, "[%p]", "")
	return string.gsub(txt, "^%s*(.-)%s*$", "%1")
end

local function executeParsedCommand(rawText)
	local lowerText = string.lower(rawText)
	local cleanText = normalizeText(rawText)

	-- Check conversational queries first
	if checkConversationalQueries(rawText) then
		return true
	end

	-- BLAST COMMAND
	if string.find(lowerText, "blast") then
		StatusLabel.Text = "STATUS: BLASTING"
		logToHUD("[Jarvis]: Target engaged. Firing blast...", false)
		sendPublicChat("Firing blast...")

		task.spawn(function()
			local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
			local hum = char:WaitForChild("Humanoid")
			local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)

			local success, animObj = pcall(function() return game:GetObjects("rbxassetid://82511722569828")[1] end)
			if not success or not animObj then
				animObj = Instance.new("Animation")
				animObj.AnimationId = "rbxassetid://82511722569828"
			end

			local track = animator:LoadAnimation(animObj)
			track.Priority = Enum.AnimationPriority.Action4
			track.Looped = false
			track:Play()
			track:AdjustSpeed(0.5)

			track.Ended:Wait()
			track:Stop()

			StatusLabel.Text = "STATUS: STANDBY"
			logToHUD("[Jarvis]: Blast sequence complete.", false)
		end)
		return true
	end

	-- ENABLE AURA
	if string.find(lowerText, "enable aura") or cleanText == "aura" then
		loadAccessoriesSilent({"73566197701787"})
		StatusLabel.Text = "STATUS: AURA ACTIVE"
		logToHUD("[Jarvis]: Aura enabled.", false)
		sendPublicChat("Aura enabled.")
		return true
	end

	-- DISABLE AURA
	if string.find(lowerText, "disable aura") or cleanText == "un-aura" or cleanText == "unaura" or string.find(lowerText, "remove aura") then
		removeSpecificAccessory("73566197701787")
		StatusLabel.Text = "STATUS: STANDBY"
		logToHUD("[Jarvis]: Aura disabled.", false)
		sendPublicChat("Aura disabled.")
		return true
	end

	-- UNSUIT COMMAND
	if string.find(lowerText, "unsuit") then
		revertToDefaultAnims()
		StatusLabel.Text = "STATUS: SUIT RETRACTED"
		logToHUD("[Jarvis]: Suit retracted. Default animations active.", false)
		sendPublicChat("Suit retracted.")
		return true
	end

	-- SUIT COMMAND
	if string.find(lowerText, "suit") then
		applySuitAnims()
		StatusLabel.Text = "STATUS: SUIT DEPLOYED"
		logToHUD("[Jarvis]: Suit animations active.", false)
		sendPublicChat("Suit deployed.")
		return true
	end

	-- UNFLY
	if string.find(lowerText, "unfly") then
		stopFlight()
		StatusLabel.Text = "STATUS: STANDBY"
		logToHUD("[Jarvis]: Unflying.", false)
		sendPublicChat("Unflying.")
		return true
	end

	-- FLY
	if string.find(lowerText, "fly") then
		if not _G.SuitActive then
			StatusLabel.Text = "STATUS: SUIT REQUIRED"
			logToHUD("[Jarvis]: Suit not deployed yet, Sir.", true)
			sendPublicChat("Suit not deployed yet, Sir.")
			return true
		end

		isFlying = true
		StatusLabel.Text = "STATUS: FLYING"
		logToHUD("[Jarvis]: Flying.", false)
		sendPublicChat("Flying")
		return true
	end

	return false
end

local function processCommand(rawMsg)
	if type(rawMsg) ~= "string" or string.find(string.lower(rawMsg), "^%[jarvis%]:") then return end
	local clean = normalizeText(rawMsg)

	if clean == "hey jarvis" or clean == "jarvis" then
		isListening = true
		StatusLabel.Text = "STATUS: LISTENING..."
		logToHUD("[Jarvis]: Listening...", false)
		sendPublicChat("Listening...")
		return
	end

	local cleanedCmd = string.match(string.lower(rawMsg), "^hey%s+jarvis%s+(.+)$") or string.match(string.lower(rawMsg), "^jarvis%s+(.+)$")
	if cleanedCmd then
		isListening = false
		executeParsedCommand(cleanedCmd)
		return
	end

	if isListening then
		isListening = false
		executeParsedCommand(rawMsg)
	end
end

