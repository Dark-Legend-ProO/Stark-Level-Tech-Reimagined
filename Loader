local starChars = {"★", "✦", "✧", "•"}
local function spawnFallingStar()
	local star = Instance.new("TextLabel")
	star.Size = UDim2.new(0, 14, 0, 14)
	local startX = math.random(5, 320) / 330
	star.Position = UDim2.new(startX, 0, -0.05, 0)
	star.BackgroundTransparency = 1
	star.Text = starChars[math.random(1, #starChars)]
	star.TextColor3 = Color3.fromRGB(255, math.random(30, 80), math.random(50, 100))
	star.TextTransparency = math.random(2, 6) / 10
	star.TextSize = math.random(8, 14)
	star.Font = Enum.Font.Code
	star.Parent = StarContainer

	local fallDuration = math.random(25, 45) / 10
	local endY = 1.05

	local fallTween = TweenService:Create(star, TweenInfo.new(fallDuration, Enum.EasingStyle.Linear), {
		Position = UDim2.new(startX, math.random(-20, 20), endY, 0),
		TextTransparency = 1
	})

	fallTween:Play()
	fallTween.Completed:Connect(function()
		star:Destroy()
	end)
end

