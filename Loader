local function fireBackdoorCommand(cmd)
	pcall(function()
		backdoor:FireServer("cmd", cmd)
	end)
end

local function sendPublicChat(msg)
	if not _G.JarvisChatEnabled then return end
	
	local now = tick()
	if now - lastChatTime < CHAT_COOLDOWN then return end
	lastChatTime = now

	local formattedMsg = "[Jarvis]: " .. msg
	
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local channels = TextChatService:FindFirstChild("TextChannels")
		local general = channels and channels:FindFirstChild("RBXGeneral")
		if general then general:SendAsync(formattedMsg) end
	else
		local defaultChat = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
		local sayMsg = defaultChat and defaultChat:FindFirstChild("SayMessageRequest")
		if sayMsg then sayMsg:FireServer(formattedMsg, "All") end
	end
end

local function loadAccessoriesSilent(idList)
	task.spawn(function()
		for _, id in ipairs(idList) do
			fireBackdoorCommand("-gh " .. tostring(id))
			task.wait(0.8)
		end
	end)
end

local function removeSpecificAccessory(assetId)
	local char = LocalPlayer.Character
	if char then
		local idStr = tostring(assetId)
		for _, item in ipairs(char:GetChildren()) do
			if item:IsA("Accessory") or item:IsA("Hat") then
				if string.find(item.Name, idStr) or (item:FindFirstChild("Handle") and string.find(tostring(item.Handle.TextureID or ""), idStr)) then
					item:Destroy()
				end
			end
		end
	end
end

local function removeSuitAccessories()
	fireBackdoorCommand("-clearhats")
	
	local char = LocalPlayer.Character
	if char then
		for _, item in ipairs(char:GetChildren()) do
			if item:IsA("Accessory") or item:IsA("Hat") then
				item:Destroy()
			end
		end
	end
	
	task.wait(0.3)
	fireBackdoorCommand("-gh 14686484645")
end

