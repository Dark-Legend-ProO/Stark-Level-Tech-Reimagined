local loadedTracks = {}

local function stopAllSuitTracks()
	for name, track in pairs(loadedTracks) do
		if track and track.IsPlaying then
			track:Stop(0.1)
		end
	end
end

local function applySuitAnims()
	local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local hum = char:WaitForChild("Humanoid")
	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)

	for _, track in pairs(animator:GetPlayingAnimationTracks()) do
		track:Stop()
	end

	local animate = char:FindFirstChild("Animate")
	if animate then
		animate.Enabled = false
	end

	local function createTrack(id)
		local success, animObj = pcall(function() return game:GetObjects("rbxassetid://" .. id)[1] end)
		if not success or not animObj then
			animObj = Instance.new("Animation")
			animObj.AnimationId = "rbxassetid://" .. id
		end
		local track = animator:LoadAnimation(animObj)
		track.Priority = Enum.AnimationPriority.Action4
		track.Looped = true
		return track
	end

	loadedTracks.Idle = createTrack(SuitIDs.Idle)
	loadedTracks.Move = createTrack(SuitIDs.Move)
	loadedTracks.Jump = createTrack(SuitIDs.Jump)

	_G.SuitActive = true
	
	loadAccessoriesSilent(SuitHats)
end

local function revertToDefaultAnims()
	stopFlight()
	_G.SuitActive = false
	stopAllSuitTracks()

	removeSuitAccessories()

	local char = LocalPlayer.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		for _, track in pairs(hum:GetPlayingAnimationTracks()) do
			track:Stop(0.1)
		end
	end

	local animate = char:FindFirstChild("Animate")
	if animate then
		animate.Enabled = false
		task.wait(0.05)
		animate.Enabled = true
	end
end

-- Custom State Loop
local suitLoopConn = RunService.Heartbeat:Connect(function()
	if not _G.SuitActive then return end

	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or not loadedTracks.Idle then return end

	local state = hum:GetState()
	local isMoving = hum.MoveDirection.Magnitude > 0

	if state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Climbing or state == Enum.HumanoidStateType.Swimming then
		if loadedTracks.Move.IsPlaying then loadedTracks.Move:Stop() end
		if loadedTracks.Idle.IsPlaying then loadedTracks.Idle:Stop() end
		if not loadedTracks.Jump.IsPlaying then 
			loadedTracks.Jump:Play() 
		end
	elseif isMoving then
		if loadedTracks.Idle.IsPlaying then loadedTracks.Idle:Stop() end
		if loadedTracks.Jump.IsPlaying then loadedTracks.Jump:Stop() end
		if not loadedTracks.Move.IsPlaying then 
			loadedTracks.Move:Play() 
			loadedTracks.Move:AdjustSpeed(0.3)
		end
	else
		if loadedTracks.Move.IsPlaying then loadedTracks.Move:Stop() end
		if loadedTracks.Jump.IsPlaying then loadedTracks.Jump:Stop() end
		if not loadedTracks.Idle.IsPlaying then 
			loadedTracks.Idle:Play() 
		end
	end
end)
table.insert(_G.JarvisConnections, suitLoopConn)

